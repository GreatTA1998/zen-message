{
  "expo": {
    "name": "Zen Message",
    "slug": "zen-message",
    "owner": "eltonlin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": true
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zen Message uses photos you choose to send.",
          "cameraPermission": "Zen Message uses the camera to take a photo to send.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.greatta1998.zenmessage",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/three-pebbles-no-bg.png"
    },
    "extra": {
      "eas": {
        "projectId": "e3fc4578-dcc0-44a6-a242-23af1e9e637f"
      }
    }
  }
}
